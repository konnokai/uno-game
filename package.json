{
  "name": "uno",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": ">=10.15.0 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @uno/server --filter @uno/web dev",
    "build": "pnpm --filter @uno/shared build && pnpm --filter @uno/server build && pnpm --filter @uno/web build",
    "host:local": "pnpm build && pnpm start",
    "start": "cross-env NODE_ENV=production node apps/server/dist/index.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
